# Verification model (OpenAI-compatible chat-completions endpoint)
RAGCV_LLM_BASE_URL=https://api.openai.com/v1
RAGCV_LLM_API_KEY=
RAGCV_LLM_MODEL=gpt-4o-mini

# LightRAG indexing/query model. It may point to the same endpoint as above.
RAGCV_LIGHTRAG_LLM_BASE_URL=https://api.openai.com/v1
RAGCV_LIGHTRAG_LLM_API_KEY=
RAGCV_LIGHTRAG_LLM_MODEL=gpt-4o-mini

# LightRAG embedding model. Keep the model and dimension unchanged for an existing index.
RAGCV_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAGCV_EMBEDDING_API_KEY=
RAGCV_EMBEDDING_MODEL=text-embedding-3-small
RAGCV_EMBEDDING_DIMENSION=1536
